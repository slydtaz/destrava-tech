---
import { localizedPath, t } from '../i18n';
import type { Lang } from '../i18n';
import LanguageSelect from './LanguageSelect.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath: string;
  lang: Lang;
}

const { currentPath, lang } = Astro.props;

const links = [
  { href: '/', key: 'nav.home' },
  { href: '/guias/', key: 'nav.guides' },
  { href: '/sobre/', key: 'nav.about' },
  { href: '/contato/', key: 'nav.contact' },
] as const;

// Compara caminhos sem prefixo de idioma: aria-current reflete a seção atual
// tanto na raiz (PT) quanto nas rotas /en/ e /es/.
const barePath = localizedPath('pt', currentPath);
const isCurrent = (href: string): 'page' | 'location' | undefined => {
  if (href === barePath) return 'page';
  if (href !== '/' && barePath.startsWith(href)) return 'location';
  return undefined;
};
---

<header class="site-header">
  <div class="header-inner container">
    <a class="site-logo" href={localizedPath(lang, '/')}>
      <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <path d="M38 6 L16 36 h12 L24 58 L50 26 H37 Z" style="fill:var(--color-accent)"></path>
        <path d="M12 52 L20 44 M44 12 L52 4" fill="none" style="stroke:var(--color-primary);stroke-width:4;stroke-linecap:round"></path>
      </svg>
      <span class="logo-text">Destrava Tech</span>
    </a>
    <LanguageSelect lang={lang} currentPath={currentPath} />
    <ThemeToggle lang={lang} />
    <nav class="site-nav" aria-label={t(lang, 'nav.main')}>
      <button
        class="menu-button"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="toggle"
        aria-controls="site-menu"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <span class="menu-text">{t(lang, 'nav.menu')}</span>
      </button>
      <ul id="site-menu" class="site-menu" popover="auto">
        {
          links.map((link) => (
            <li>
              <a href={localizedPath(lang, link.href)} aria-current={isCurrent(link.href)}>
                {t(lang, link.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
