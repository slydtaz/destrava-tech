---
// Banner de consentimento (LGPD) — só aparece quando anúncios forem ativados.
// O site carrega o Google Tag Manager, mas o banner continua desligado até o AdSense ser aprovado
// (guia content-first-noise-reduction: não mostrar banner sem necessidade real).
import { SITE } from '../site.config';
import { localizedPath, t } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

{
  SITE.adsEnabled && (
    <div class="consent-bar" role="region" aria-label={t(lang, 'consent.label')}>
      <p>
        {t(lang, 'consent.text')}{' '}
        <a href={localizedPath(lang, '/privacidade/')}>{t(lang, 'consent.privacy')}</a>.
      </p>
      <button type="button" class="consent-reject" data-consent="reject">{t(lang, 'consent.reject')}</button>
      <button type="button" class="consent-accept" data-consent="accept">{t(lang, 'consent.accept')}</button>
    </div>
  )
}

<script>
  // Guarda apenas a escolha de consentimento (dado não sensível).
  const bar = document.querySelector<HTMLElement>('.consent-bar');
  if (bar) {
    const KEY = 'dt-consent';
    const saved = localStorage.getItem(KEY);
    if (saved) {
      bar.remove();
    } else {
      bar.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-consent]');
        if (!btn) return;
        localStorage.setItem(KEY, btn.dataset.consent === 'accept' ? 'accepted' : 'rejected');
        bar.remove();
        // TODO(ads): carregar o script do AdSense SOMENTE aqui, se 'accepted'.
      });
    }
  }
</script>
