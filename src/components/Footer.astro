---
import { SITE } from '../site.config';
import { localizedPath, t } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const rights = t(lang, 'footer.rights').replace('{year}', String(year));

const links = [
  { href: '/guias/', key: 'footer.guides' },
  { href: '/sobre/', key: 'footer.about' },
  { href: '/contato/', key: 'footer.contact' },
  { href: '/privacidade/', key: 'footer.privacy' },
  { href: '/termos/', key: 'footer.terms' },
] as const;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>{SITE.name}</strong>
      <p>{t(lang, 'footer.tagline')}<br />{rights}</p>
    </div>
    <nav class="footer-nav" aria-label={t(lang, 'footer.nav')}>
      <ul>
        {
          links.map((link) => (
            <li><a href={localizedPath(lang, link.href)}>{t(lang, link.key)}</a></li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
