---
import { getCollection } from 'astro:content';
import GuidePage from '../../../components/GuidePage.astro';
import { slugFromId } from '../../../i18n';

export async function getStaticPaths() {
  const guias = await getCollection('guias', ({ data }) => !data.draft && data.lang === 'en');
  return guias.map((entry) => ({
    params: { id: slugFromId(entry.id) },
    props: { entry, lang: 'en' as const },
  }));
}

const { entry, lang } = Astro.props;
---

<GuidePage entry={entry} lang={lang} />
