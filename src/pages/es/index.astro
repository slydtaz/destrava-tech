---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';
import { SITE, PILLARS, type PillarKey } from '../../site.config';
import { localizedPath, slugFromId, t, type Lang } from '../../i18n';

const lang: Lang = 'es';
const guias = (await getCollection('guias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
const latest = guias.slice(0, 6);
const pillarKeys = Object.keys(PILLARS) as PillarKey[];
const pillarText: Record<PillarKey, { label: string; description: string }> = {
  seguranca: { label: 'Seguridad digital', description: 'Estafas, contraseñas y protección diaria' },
  whatsapp: { label: 'WhatsApp', description: 'Funciones, privacidad y Meta AI' },
  ia: { label: 'IA en la práctica', description: 'Inteligencia artificial para estudiar y hacer tareas' },
  celular: { label: 'Celular', description: 'Almacenamiento, batería, datos y apps' },
};
const dateFmt = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long', timeZone: 'UTC' });
const splitLead = (text: string): [string, string] => {
  const dot = text.indexOf('. ');
  return dot === -1 ? [text, ''] : [text.slice(0, dot + 1), text.slice(dot + 2)];
};
const trust = [
  t(lang, 'home.trust1'),
  t(lang, 'home.trust2'),
  t(lang, 'home.trust3'),
  t(lang, 'home.trust4'),
].map(splitLead);
const privacyLabel = t(lang, 'consent.privacy');
const privacyIndex = trust[3][1].indexOf(privacyLabel);
const privacyBefore = trust[3][1].slice(0, privacyIndex);
const privacyAfter = trust[3][1].slice(privacyIndex + privacyLabel.length);
---

<Base
  title={SITE.name}
  description="Guías prácticas de tecnología en lenguaje sencillo: seguridad digital, WhatsApp, inteligencia artificial y celular. Pasos que puedes comprobar, sin jerga."
  lang={lang}
  path={Astro.url.pathname}
>
  <div class="container">
    <TranslationNotice lang={lang} ptHref={localizedPath('pt', Astro.url.pathname)} />

    <section class="hero">
      <span class="kicker">{t(lang, 'home.kicker')}</span>
      <h1>{t(lang, 'home.title')}</h1>
      <p class="lead">{t(lang, 'home.lead')}</p>
      <p>
        <a class="button" href={localizedPath(lang, '/guias/')}>{t(lang, 'home.cta')}</a>
      </p>
    </section>

    <section class="section" aria-labelledby="pilares">
      <div class="section-head">
        <h2 id="pilares">{t(lang, 'home.pillars')}</h2>
      </div>
      <ul class="card-grid">
        {
          pillarKeys.map((key) => (
            <li>
              <a class="card pillar-card" href={localizedPath(lang, `/guias/#${key}`)}>
                <h3>{pillarText[key].label}</h3>
                <p>{pillarText[key].description}</p>
                <p class="card-meta">
                  {guias.filter((g) => g.data.pillar === key).length} {t(lang, 'guides.count')}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="como-funciona">
      <div class="section-head">
        <h2 id="como-funciona">{t(lang, 'home.how')}</h2>
      </div>
      <div class="prose">
        <p>{t(lang, 'home.howLine')}</p>
      </div>
    </section>

    <section class="section" aria-labelledby="recentes">
      <div class="section-head">
        <h2 id="recentes">{t(lang, 'home.recent')}</h2>
        <a href={localizedPath(lang, '/guias/')}>{t(lang, 'home.cta')} →</a>
      </div>
      <ul class="card-grid">
        {
          latest.map((g) => (
            <li class="card">
              <span class="badge">{pillarText[g.data.pillar].label}</span>
              <h3>
                <a href={localizedPath(lang, `/guias/${slugFromId(g.id)}/`)}>{g.data.title}</a>
              </h3>
              <p>{g.data.description}</p>
              <p class="card-meta">
                {t(lang, 'article.updated')}
                <time datetime={g.data.updated.toISOString().slice(0, 10)}>{dateFmt.format(g.data.updated)}</time>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="confianca">
      <div class="section-head">
        <h2 id="confianca">{t(lang, 'home.trust')}</h2>
      </div>
      <div class="prose">
        <ul>
          <li><strong>{trust[0][0]}</strong> {trust[0][1]}</li>
          <li><strong>{trust[1][0]}</strong> {trust[1][1]}</li>
          <li><strong>{trust[2][0]}</strong> {trust[2][1]}</li>
          <li>
            <strong>{trust[3][0]}</strong> {privacyBefore}<a href={localizedPath(lang, '/privacidade/')}>{privacyLabel}</a>{privacyAfter}
          </li>
        </ul>
      </div>
    </section>
  </div>
</Base>
