---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import { LANGS, localizedPath, t } from '../i18n';
---

<Base title={t('pt', 'notfound.title')} description={t('pt', 'notfound.lead')}>
  <div class="container">
    <section class="hero">
      <Illustration src="/illustrations/notfound.svg" />
      <span class="kicker">{t('pt', 'notfound.kicker')}</span>
      <h1>{t('pt', 'notfound.title')}</h1>
      <p class="lead">{t('pt', 'notfound.lead')}</p>
    </section>

    {
      LANGS.map((lang) => (
        <section class="section">
          <div class="section-head">
            <h2>{t(lang, `lang.${lang}`)}</h2>
            <span class="kicker">{t(lang, 'notfound.kicker')}</span>
          </div>
          <h3>{t(lang, 'notfound.title')}</h3>
          <p class="lead">{t(lang, 'notfound.lead')}</p>
          <p class="error-actions">
            <a class="button" href={localizedPath(lang, '/')}>
              {t(lang, 'notfound.home')}
            </a>
            <a class="button secondary" href={localizedPath(lang, '/guias/')}>
              {t(lang, 'notfound.guides')}
            </a>
          </p>
        </section>
      ))
    }
  </div>
</Base>
