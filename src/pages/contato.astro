---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import { SITE } from '../site.config';
---

<Base
  title="Contato"
  description="Fale com o Destrava Tech: correções, sugestões de guia e dúvidas sobre privacidade."
>
  <div class="container">
    <section class="hero">
      <Illustration src="/illustrations/contact.svg" />
      <span class="kicker">Contato</span>
      <h1>Fale com a gente</h1>
      <p class="lead">
        Encontrou um passo desatualizado? Tem uma dúvida que viraria um bom guia? Escreva.
      </p>
    </section>

    <section class="section">
      <div class="legal-body">
        <h2>E-mail</h2>
        <p>
          <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        </p>
        <p>
          Respondemos assim que possível. Para pedidos sobre seus dados pessoais
          (LGPD), use o assunto <strong>“Privacidade”</strong> — veja a
          <a href="/privacidade/">Política de Privacidade</a>.
        </p>

        <h2>O que NÃO enviar</h2>
        <p>
          Nunca envie senhas, códigos de verificação, números de cartão ou documentos por
          e-mail. Nenhuma empresa séria pede isso — e nós também não.
        </p>
      </div>
    </section>
  </div>
</Base>