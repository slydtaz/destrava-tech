---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { PILLARS, type PillarKey } from '../../site.config';
import { slugFromId, t } from '../../i18n';

const guias = (await getCollection('guias', ({ data }) => !data.draft && data.lang === 'pt')).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
const pillarKeys = Object.keys(PILLARS) as PillarKey[];
---

<Base title={t('pt', 'guides.title')} description={t('pt', 'guides.lead')} lang="pt">
  <div class="container">
    <section class="hero">
      <span class="kicker">{t('pt', 'guides.kicker')}</span>
      <h1>{t('pt', 'guides.title')}</h1>
      <p class="lead">{t('pt', 'guides.lead')}</p>
    </section>

    <nav class="pillar-filter" aria-label={t('pt', 'guides.filterLabel')}>
      <button type="button" data-pillar-filter="all" aria-pressed="true">
        {t('pt', 'guides.filterAll')}
      </button>
      {
        pillarKeys
          .filter((key) => guias.some((g) => g.data.pillar === key))
          .map((key) => (
            <button type="button" data-pillar-filter={key} aria-pressed="false">
              {t('pt', `pillar.${key}`)}
            </button>
          ))
      }
    </nav>

    {
      pillarKeys.map((key) => {
        const items = guias.filter((g) => g.data.pillar === key);
        if (items.length === 0) return null;
        return (
          <section class="section" id={key} data-pillar-section={key} aria-labelledby={`h-${key}`}>
            <div class="section-head">
              <h2 id={`h-${key}`}>{t('pt', `pillar.${key}`)}</h2>
              <p>{t('pt', `pillar.${key}.description`)}</p>
            </div>
            <ul class="card-grid">
              {items.map((g) => (
                <ArticleCard
                  id={slugFromId(g.id)}
                  title={g.data.title}
                  description={g.data.description}
                  pillar={g.data.pillar}
                  updated={g.data.updated}
                  lang="pt"
                />
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</Base>
