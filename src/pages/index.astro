---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, PILLARS, type PillarKey } from '../site.config';

const guias = (await getCollection('guias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
const latest = guias.slice(0, 6);
const pillarKeys = Object.keys(PILLARS) as PillarKey[];
---

<Base title={SITE.name} description={SITE.description}>
  <div class="container">
    <section class="hero">
      <span class="kicker">Guias práticos · Português simples</span>
      <h1>Tecnologia explicada sem complicação</h1>
      <p class="lead">
        Passo a passo de verdade para o dia a dia: proteger-se de golpes, usar o WhatsApp
        melhor, aproveitar a inteligência artificial e resolver os problemas do celular.
        Sem jargão, sem enrolação, com fontes e data de atualização.
      </p>
      <p>
        <a class="button" href="/guias/">Ver todos os guias</a>
      </p>
    </section>

    <section class="section" aria-labelledby="pilares">
      <div class="section-head">
        <h2 id="pilares">Por onde começar</h2>
      </div>
      <ul class="card-grid">
        {
          pillarKeys.map((key) => (
            <li>
              <a class="card pillar-card" href={`/guias/#${key}`}>
                <h3>{PILLARS[key].label}</h3>
                <p>{PILLARS[key].description}</p>
                <p class="card-meta">
                  {guias.filter((g) => g.data.pillar === key).length} guias
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="recentes">
      <div class="section-head">
        <h2 id="recentes">Guias recentes</h2>
        <a href="/guias/">Ver todos →</a>
      </div>
      <ul class="card-grid">
        {
          latest.map((g) => (
            <ArticleCard
              id={g.id}
              title={g.data.title}
              description={g.data.description}
              pillar={g.data.pillar}
              updated={g.data.updated}
            />
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="confianca">
      <div class="section-head">
        <h2 id="confianca">Como este site trabalha</h2>
      </div>
      <div class="prose">
        <ul>
          <li><strong>Conteúdo original e revisado.</strong> Cada guia é escrito para responder uma dúvida real e passa por revisão humana antes de ser publicado.</li>
          <li><strong>Fontes citadas.</strong> Quando um guia afirma algo sobre segurança ou regras de apps, ele aponta a fonte oficial para você conferir.</li>
          <li><strong>Data de atualização visível.</strong> Tecnologia muda rápido; você sempre sabe quando o guia foi revisado pela última vez.</li>
          <li><strong>Respeito à sua privacidade.</strong> O site não pede cadastro nem usa cookies; o servidor registra apenas dados técnicos de acesso. Veja a <a href="/privacidade/">Política de Privacidade</a>.</li>
        </ul>
      </div>
    </section>
  </div>
</Base>